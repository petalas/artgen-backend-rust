+fn consumed_tiles(offspring_id: u32, image_size: vec2<u32>, tile_count: vec2<u32>) -> vec4<u32> {
+    let bbox_lo = working_states[offspring_id].fitness_bits;
+    let bbox_hi = working_states[offspring_id].stagnation_counter;
+    let dirty_min = vec2<u32>(bbox_lo & 0xFFFFu, bbox_lo >> 16u);
+    let dirty_max = vec2<u32>(bbox_hi & 0xFFFFu, bbox_hi >> 16u);
+    // The rasterizer clips the last tile's end to the image, not its padded size.
+    if any(dirty_min >= image_size) {
+        return vec4<u32>(0u);
+    }
+    let tile_size = vec2<u32>(TILE_W, TILE_H);
+    // Match tile_end > dirty_min && tile_start < dirty_max on each axis.
+    // Do not reject inverted/zero-width boxes: they can still consume a tile.
+    // Decoded u16 controls plus tile_size - 1 cannot overflow, even at 65535.
+    return vec4<u32>(dirty_min / tile_size,
+        min((dirty_max + tile_size - vec2<u32>(1u)) / tile_size, tile_count));
+}
+
+struct PackedLimits {
+    lower: vec2<u32>,
+    upper: vec2<u32>,
+    enabled: bool,
+}
+
+fn packed_axis_limits(consumed: vec2<u32>, dim: u32) -> vec2<u32> {
+    var lower = 0u;
+    var upper = 65536u;
+    // One pixel of slack exceeds the old f32 decode/multiply error for dim <= 512.
+    if consumed.x > 0u {
+        lower = ((consumed.x - 1u) * 65535u) / dim + 1u;
+    }
+    // At the image edge, q=65535 can enter the original partial final tile.
+    if consumed.y < dim {
+        upper = ((consumed.y + 1u) * 65535u + dim - 1u) / dim;
+    }
+    return vec2<u32>(lower, upper);
+}
+
+// The caller has already returned when the consumed tile rectangle is empty.
+fn packed_limits(consumed: vec4<u32>, w: u32, h: u32) -> PackedLimits {
+    var limits = PackedLimits(vec2<u32>(0u), vec2<u32>(65536u), false);
+    // Outside the proved range, retain dirty clipping and the original float bounds.
+    if w == 0u || h == 0u || w > 512u || h > 512u {
+        return limits;
+    }
+    let tile_size = vec2<u32>(TILE_W, TILE_H);
+    let pixel_min = consumed.xy * tile_size;
+    let pixel_max = min(consumed.zw * tile_size, vec2<u32>(w, h));
+    // Initial/full evaluation and crossover consume the whole image.
+    if all(pixel_min == vec2<u32>(0u)) && all(pixel_max == vec2<u32>(w, h)) {
+        return limits;
+    }
+    let x_limits = packed_axis_limits(vec2<u32>(pixel_min.x, pixel_max.x), w);
+    let y_limits = packed_axis_limits(vec2<u32>(pixel_min.y, pixel_max.y), h);
+    limits.lower = vec2<u32>(x_limits.x, y_limits.x);
+    limits.upper = vec2<u32>(x_limits.y, y_limits.y);
+    limits.enabled = true;
+    return limits;
+}
+
+fn packed_misses(poly: Polygon, limits: PackedLimits) -> bool {
+    let a = vec2<u32>(poly.data.y & 0xFFFFu, poly.data.y >> 16u);
+    let b = vec2<u32>(poly.data.z & 0xFFFFu, poly.data.z >> 16u);
+    let c = vec2<u32>(poly.data.w & 0xFFFFu, poly.data.w >> 16u);
+    return any(max(a, max(b, c)) < limits.lower) || any(min(a, min(b, c)) >= limits.upper);
+}
