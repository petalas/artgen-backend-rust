+struct PackedLimits {
+    lower: vec2<u32>,
+    upper: vec2<u32>,
+    empty: bool,
+    enabled: bool,
+}
+
+// Match the rasterizer's strict tile_end > dirty_min && tile_start < dirty_max.
+// Zero-width and inverted boxes can still consume an interior tile.
+fn consumed_axis(dim: u32, tile: u32, dirty_min: u32, dirty_max: u32) -> vec2<u32> {
+    if dirty_min >= dim {
+        return vec2<u32>(0u);
+    }
+    let start = (dirty_min / tile) * tile;
+    let end = min(((dirty_max + tile - 1u) / tile) * tile, dim);
+    return vec2<u32>(start, end);
+}
+
+fn packed_axis_limits(consumed: vec2<u32>, dim: u32) -> vec2<u32> {
+    var lower = 0u;
+    var upper = 65536u;
+    // One pixel of slack exceeds the old f32 decode/multiply error for dim <= 512.
+    if consumed.x > 0u {
+        lower = ((consumed.x - 1u) * 65535u) / dim + 1u;
+    }
+    // At the image edge, q=65535 can enter the original partial final tile.
+    if consumed.y < dim {
+        upper = ((consumed.y + 1u) * 65535u + dim - 1u) / dim;
+    }
+    return vec2<u32>(lower, upper);
+}
+
+fn packed_limits(offspring_id: u32, w: u32, h: u32) -> PackedLimits {
+    var limits = PackedLimits(vec2<u32>(0u), vec2<u32>(65536u), false, false);
+    // Outside the proved range, run the original full binner.
+    if w == 0u || h == 0u || w > 512u || h > 512u {
+        return limits;
+    }
+    let dirty_min = working_states[offspring_id].fitness_bits;
+    let dirty_max = working_states[offspring_id].stagnation_counter;
+    let x = consumed_axis(w, TILE_W, dirty_min & 0xFFFFu, dirty_max & 0xFFFFu);
+    let y = consumed_axis(h, TILE_H, dirty_min >> 16u, dirty_max >> 16u);
+    if x.x >= x.y || y.x >= y.y {
+        limits.empty = true;
+        return limits;
+    }
+    // Initial/full evaluation and crossover consume the whole image.
+    if x.x == 0u && x.y == w && y.x == 0u && y.y == h {
+        return limits;
+    }
+    let x_limits = packed_axis_limits(x, w);
+    let y_limits = packed_axis_limits(y, h);
+    limits.lower = vec2<u32>(x_limits.x, y_limits.x);
+    limits.upper = vec2<u32>(x_limits.y, y_limits.y);
+    limits.enabled = true;
+    return limits;
+}
+
+fn packed_misses(poly: Polygon, limits: PackedLimits) -> bool {
+    let a = vec2<u32>(poly.data.y & 0xFFFFu, poly.data.y >> 16u);
+    let b = vec2<u32>(poly.data.z & 0xFFFFu, poly.data.z >> 16u);
+    let c = vec2<u32>(poly.data.w & 0xFFFFu, poly.data.w >> 16u);
+    return any(max(a, max(b, c)) < limits.lower) || any(min(a, min(b, c)) >= limits.upper);
+}
