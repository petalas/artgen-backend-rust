+def validate_qualification(b, record, case, args, manifest_hash):
+    """Apply the TrialRecord checks to an explicitly unscored qualification."""
+    b.object_value(record, "result")
+    b.require(record.get("timestamp_mode", "stages") == "stages"
+              and record.get("batch_compute_envelope") is None,
+              "profiling records cannot enter the reference timing score")
+    b.require(type(record.get("protocol_version")) is int and record["protocol_version"] == 1,
+              "unsupported result protocol")
+    b.require(record.get("status") == "completed", "trial did not complete validly")
+    b.require(type(record.get("correctness")) is bool and record["correctness"], "numerical correctness failed")
+    b.require(record.get("errors") == [] and type(record.get("errors")) is list, "trial reported errors")
+    b.require(type(record.get("error_count")) is int and record["error_count"] == 0, "trial error_count is not zero")
+    for key, expected in (("case_id", case["case_id"]), ("seed", args.seed),
+                          ("batches", args.batches), ("diagnostic", False)):
+        b.require(type(record.get(key)) is type(expected) and record[key] == expected,
+                  f"result {key} differs from requested trial")
+    b.require(record.get("fixture_manifest_sha256") == manifest_hash, "fixture manifest hash mismatch")
+    for key in ("initial_state_sha256", "final_state_sha256"):
+        b.digest_value(record.get(key), key)
+    b.require(record["initial_state_sha256"] != record["final_state_sha256"],
+              "no evolution state changed despite reported completed work")
+    params = b.object_value(record.get("params"), "result.params")
+    b.require(params == case["params"], "effective parameters differ from frozen case")
+    require(json.dumps(params, sort_keys=True) == json.dumps(case["params"], sort_keys=True),
+            "typed params differ")
+    counters = b.object_value(record.get("counters"), "result.counters")
+    for key, expected in b.expected_work(params, args.batches).items():
+        for side in ("submitted", "completed"):
+            field = f"{side}_{key}"
+            b.require(type(counters.get(field)) is int and counters[field] == expected,
+                      f"wrong completed work: {field}, expected {expected}, got {counters.get(field)}")
+    elapsed = b.finite(record.get("elapsed_seconds"), 1e-9, args.timeout, "elapsed_seconds")
+    b.finite(record.get("drain_seconds"), 0, elapsed, "drain_seconds")
+    # qualify_inner never assigns a rate; finish_record does not create one.
+    b.require("evals_per_second" in record and record["evals_per_second"] is None,
+              "qualification evals_per_second must be null (unscored)")
+    b.finite(record.get("initial_similarity_percent"), 97.000000001, 100, "initial_similarity_percent")
+    fitness = record.get("final_fitness_percent")
+    b.require(isinstance(fitness, list) and len(fitness) == params["chainCount"], "missing final per-chain fitness")
+    for value in fitness:
+        b.finite(value, 0, 100, "final_fitness_percent")
+    b.validate_quality_record(record, case)
+    b.object_value(record.get("gpu"), "gpu provenance")
+    return record
+
