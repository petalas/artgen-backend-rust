+"""Read-only CPU regression against the completed, immutable AA artifacts."""
+import copy
+import importlib.util
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location("qualification_controller", HERE / "run-campaign.py")
+C = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(C)
+
+
+class ActualQualificationContract(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.compare, cls.b = C.load_helpers()
+        cls.spec = cls.b.read_json(C.TARGET / "spec.json")
+        cls.fixtures = {case["case_id"]: case for case in
+                        cls.b.load_manifest(Path(cls.spec["identities"]["manifest"]))["cases"]}
+        cls.args = cls.b.argparse.Namespace(seed=7, batches=8, timeout=600)
+        cls.output = C.TARGET / "aa/output"
+        cls.records = {case: cls.b.read_json(cls.output / f"qualification-{case}/result.json",
+                                            2 * 1024 * 1024) for case in C.CASES}
+
+    def setUp(self):
+        for module, name in ((C, "main"), (C, "run_phases"),
+                             (self.b, "run_process"), (self.b, "write_json")):
+            guard = patch.object(module, name, side_effect=AssertionError(f"forbidden call: {name}"))
+            guard.start()
+            self.addCleanup(guard.stop)
+
+    def assert_rejected_mutation(self, path, value):
+        self.assertTrue(1 <= len(path) <= 4)
+        for case in C.CASES:
+            with self.subTest(case=case, path=path, value=value):
+                record = copy.deepcopy(self.records[case])
+                owner = record
+                for part in path[:-1]:
+                    owner = owner[part]
+                owner[path[-1]] = value
+                with self.assertRaises((C.Invalid, self.b.BenchError)):
+                    C.validate_qualification(self.b, record, self.fixtures[case], self.args, C.MANIFEST)
+
+    def test_old_actual_validator_rejects_each_nullable_qualification(self):
+        for case in C.CASES:
+            with self.subTest(case=case):
+                record = self.records[case]
+                self.assertIs(record["diagnostic"], False)
+                self.assertIn("evals_per_second", record)
+                self.assertIsNone(record["evals_per_second"])
+                with self.assertRaisesRegex(self.b.BenchError, "evals_per_second must be finite"):
+                    self.b.validate_result(record, self.fixtures[case], self.args, False, C.MANIFEST)
+
+    def test_corrected_validator_accepts_all_three_raw_records_without_mutation(self):
+        for case in C.CASES:
+            with self.subTest(case=case):
+                record = self.records[case]
+                before = copy.deepcopy(record)
+                checked = C.validate_qualification(self.b, record, self.fixtures[case], self.args, C.MANIFEST)
+                self.assertIs(checked, record)
+                self.assertEqual(record, before)
+                self.assertIs(record["diagnostic"], False)
+                self.assertIsNone(record["evals_per_second"])
+
+    def test_invalid_protocol_status_errors_and_trial_identity_rejected(self):
+        changes = (("protocol_version", True), ("protocol_version", 2), ("status", "pending"),
+                   ("correctness", False), ("correctness", 1), ("errors", ["device failure"]),
+                   ("error_count", 1), ("error_count", False), ("case_id", "wrong-case"),
+                   ("seed", 8), ("batches", 7), ("diagnostic", True), ("diagnostic", 0),
+                   ("fixture_manifest_sha256", "0" * 64), ("initial_state_sha256", "invalid"),
+                   ("timestamp_mode", "batch-envelope"), ("batch_compute_envelope", {}))
+        for key, value in changes:
+            self.assert_rejected_mutation((key,), value)
+        for case in C.CASES:
+            record = dict(self.records[case], final_state_sha256=self.records[case]["initial_state_sha256"])
+            with self.assertRaisesRegex(self.b.BenchError, "no evolution state changed"):
+                C.validate_qualification(self.b, record, self.fixtures[case], self.args, C.MANIFEST)
+
+    def test_invalid_work_in_each_submitted_completed_counter_rejected(self):
+        for key in C.COUNTERS:
+            for value in (0, True):
+                self.assert_rejected_mutation(("counters", key), value)
+
+    def test_changed_or_differently_typed_frozen_parameters_rejected(self):
+        for key, value in (("chainCount", 5), ("adaptiveMutation", 0), ("rasterizeWg", [32, 16.0]),
+                           ("gpuBatchIters", 63), ("lambda", 63), ("changeColorProb", 0.0)):
+            self.assert_rejected_mutation(("params", key), value)
+
+    def test_invalid_quality_scalar_fitness_and_stages_rejected(self):
+        changes = ((("initial_complexity", "overflowed_tiles"), 1),
+                   (("initial_quality", 0, "pixel_audit", "unexplained_pixels"), 1),
+                   (("final_quality", 0, "scalar_error"), 0),
+                   (("final_quality", 0, "framebuffer_error"), 0),
+                   (("final_quality", 0, "stored_fitness"), 0),
+                   (("final_complexity", 0, "vertices"), 0),
+                   (("final_fitness_percent", 0), float("nan")),
+                   (("final_fitness_percent",), []), (("initial_similarity_percent",), 97),
+                   (("start_mode",), "wrong"), (("timestamp_samples",), 0),
+                   (("sampled_gpu_stage_totals_ns",), [0, 0, 0]),
+                   (("sampled_gpu_stage_totals_ns", 0), float("inf")), (("gpu",), []))
+        for path, value in changes:
+            self.assert_rejected_mutation(path, value)
+
+    def test_qualification_requires_explicit_null_and_finite_elapsed_drain(self):
+        for value in (1.0, 0, False, float("inf"), float("nan")):
+            self.assert_rejected_mutation(("evals_per_second",), value)
+        for key, value in (("elapsed_seconds", 0), ("elapsed_seconds", float("nan")),
+                           ("elapsed_seconds", 601), ("drain_seconds", -1), ("drain_seconds", 601)):
+            self.assert_rejected_mutation((key,), value)
+        for case in C.CASES:
+            record = dict(self.records[case])
+            del record["evals_per_second"]
+            with self.assertRaisesRegex(self.b.BenchError, "qualification evals_per_second must be null"):
+                C.validate_qualification(self.b, record, self.fixtures[case], self.args, C.MANIFEST)
+
+    def test_actual_normal_rows_keep_finite_correct_rate_contract_and_both_flags_false(self):
+        normal = C.read_lines(self.b, self.output / "trials.jsonl", 30)
+        self.assertEqual(len(normal), 30)
+        self.assertEqual({row["variant"] for row in normal}, {"reference", "control"})
+        for row in normal:
+            self.assertIs(row["finalize_overlap"], False)
+            C.validate_row(row, C.PHASES[0], self.records[row["case_id"]])
+        row = normal[0]
+        for value in (None, 0, 1.0, False, float("nan"), float("inf")):
+            with self.subTest(rate=value), self.assertRaises(C.Invalid):
+                C.validate_row(dict(row, evals_per_second=value), C.PHASES[0], self.records["ff"])
+
+    def test_original_consumed_namespace_and_historical_stop_are_retained(self):
+        root = Path("/home/nick/git/artgen-backend-rust")
+        self.assertEqual(C.ROOT, root)
+        self.assertEqual(C.BASE, root / ".cache/evolution-qualification-prepared-20261024")
+        self.assertEqual(C.TARGET, C.BASE / "campaign")
+        self.assertTrue((C.TARGET / "clock.json").is_file())
+        historical = self.b.read_json(C.TARGET / "result.json")
+        self.assertEqual(historical["state"], "INCONCLUSIVE")
+        self.assertEqual([phase["phase"] for phase in historical["phases"]], ["aa"])
+        self.assertEqual(historical["errors"],
+                         ["BenchError: evals_per_second must be finite in 1e-09..1e+18"])
+
+    def test_actual_phase_validates_but_frozen_aa_gate_still_fails(self):
+        process = self.b.read_json(C.TARGET / "aa/evidence/process.json")
+        self.assertEqual((process["status"], process["returncode"]), ("completed", 0))
+        result = C.validate_phase(self.compare, self.b, C.TARGET / "aa", C.PHASES[0],
+                                  self.spec, self.fixtures, {})
+        self.assertIs(result["valid"], True)
+        decision = C.gate(self.compare, result["ratios"], aa=True)
+        self.assertIs(decision["pass"], False)
+        darwin = decision["statistics"]["cases"]["darwin"]["paired_ratios"]["median"]
+        self.assertAlmostEqual(darwin, 0.98732098719558, places=14)
+        self.assertLess(darwin, 0.99)
+        self.assertEqual(C.transition("NEW", "aa", "fail"), "INCONCLUSIVE")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
