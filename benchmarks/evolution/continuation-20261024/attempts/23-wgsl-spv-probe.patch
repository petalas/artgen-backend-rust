+use std::{env, fs, process};
+fn main() {
+    let args: Vec<_> = env::args().take(3).collect();
+    assert_eq!(args.len(), 2, "one WGSL path required");
+    let source = fs::read_to_string(&args[1]).expect("WGSL input");
+    let module = naga::front::wgsl::parse_str(&source).expect("WGSL parse");
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(), naga::valid::Capabilities::all())
+        .validate(&module).expect("WGSL validation");
+    let options = naga::back::spv::Options {
+        lang_version: (1, 3),
+        zero_initialize_workgroup_memory: naga::back::spv::ZeroInitializeWorkgroupMemoryMode::None,
+        ..Default::default()
+    };
+    let pipeline = naga::back::spv::PipelineOptions {
+        shader_stage: naga::ShaderStage::Compute, entry_point: "main".into()
+    };
+    // The reused release library uses panic=abort. The supervisor records aborts.
+    match naga::back::spv::write_vec(&module, &info, &options, Some(&pipeline)) {
+        Ok(words) => println!("SPIRV_OK words={}", words.len()),
+        Err(error) => { eprintln!("SPIRV_ERROR {error}"); process::exit(1); }
+    }
+}
