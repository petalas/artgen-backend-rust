@@ -0,0 +1,31 @@
+"""Replay ten CPU compiler cases. No GPU initialization or artifact writes."""
+import json
+import resource
+import subprocess
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+
+
+def no_core():
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+
+
+def main():
+    cases = json.loads((HERE / 'final-regression.json').read_text())['cases']
+    if len(cases) != 10:
+        raise ValueError('exact ten-case regression required')
+    for case in cases:
+        result = subprocess.run([str(HERE / 'spv-probe-final'), case['path']],
+                                check=False, capture_output=True, text=True, timeout=5, preexec_fn=no_core)
+        if result.returncode != case['expected_exit']:
+            raise ValueError(case['case'] + ': incorrect compiler outcome')
+        if result.returncode == 0 and not result.stdout.startswith('SPIRV_OK words='):
+            raise ValueError(case['case'] + ': missing compiled output')
+        if result.returncode == -6 and 'is not cached!' not in result.stderr:
+            raise ValueError(case['case'] + ': wrong panic')
+    print('PASS: 10 CPU compiler regressions; no GPU execution')
+
+
+if __name__ == '__main__':
+    main()
