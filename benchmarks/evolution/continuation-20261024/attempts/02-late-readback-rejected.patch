+//! Ordinary API equivalence for the default-off late-readback prototype.
+//! Run on the main thread under `timeout 600s ... --output NEWDIR`.
+//! No performance score: qualification, event hashing and JSON are outside runs.
+//! Eight fixed mature-mona batches check delivery/non-delivery, including returned
+//! drawings at the previously observed conflicts at completed batches 3 and 6. Optional 64-batch coverage
+//! uses the same fixture, seed and parameters. A/A must pass before A/B runs.
+//! Shared `trial::prepare`/`trial::complete_record` own all numerical qualification. Snapshot
+//! maps retain their existing 120-second timeout; production waits/compilation
+//! require the outer timeout. No per-batch snapshot, drain or extra engine API.
+//! Live bounds: one device, eight runs, <=64 ordinary events plus one flush per
+//! run, four fitness words per event, <=1000 triangles per returned Drawing.
+//! Existing wgpu callbacks, driver allocations and serde macros are framework
+//! deviations. Event vectors are preallocated; hashing/JSON may allocate only
+//! after the ordinary batch/flush sequence. Own JSON artifacts are capped at 2 MiB;
+//! `trial::prepare` also writes its existing bounded initial snapshot outside runs.
+use std::{fs, path::PathBuf};
+
+use anyhow::{ensure, Context, Result};
+use artgen_backend_rust::{
+    benchmark::{
+        fixtures::{self, LoadedFixture},
+        trial::{self, TimestampMode, TrialRecord, TrialSpec},
+    },
+    gpu_evolver::{
+        benchmark::{
+            BenchmarkCounters, BenchmarkMutateOptions, BenchmarkPackedState, BenchmarkSnapshot,
+        },
+        buffers::{gpu_to_drawing, GpuDrawingState, GpuPolygon},
+        GpuEvolver,
+    },
+    models::drawing::Drawing,
+};
+use bytemuck::Zeroable;
+use serde::Serialize;
+
+const MAX_ARGS: usize = 6;
+const MAX_JSON_BYTES: usize = 2 * 1024 * 1024;
+const USAGE: &str = "check-gpu-readback-order --output NEWDIR [--manifest PATH] [--batches 8|64]\nFixed mature mona, seed 7, unchanged manifest parameters. Runs A/A before A/B, with timestamps disabled and enabled. Use an outer 600-second process timeout. No GPU work for --help.";
+
+#[derive(Debug, Serialize)]
+struct Config {
+    manifest: PathBuf,
+    output: PathBuf,
+    batches: u32,
+}
+
+impl Config {
+    fn parse(args: &[String]) -> Result<Self> {
+        ensure!(
+            args.len() <= MAX_ARGS && args.len() % 2 == 0,
+            "expected --flag value pairs"
+        );
+        let mut manifest = None;
+        let mut output = None;
+        let mut batches = None;
+        for pair in args.as_chunks::<2>().0 {
+            ensure!(
+                pair.iter().all(|arg| arg.len() <= 4096),
+                "argument exceeds 4096 bytes"
+            );
+            let slot = match pair[0].as_str() {
+                "--manifest" => &mut manifest,
+                "--output" => &mut output,
+                "--batches" => &mut batches,
+                _ => anyhow::bail!("unknown flag {}", pair[0]),
+            };
+            ensure!(
+                slot.replace(pair[1].as_str()).is_none(),
+                "duplicate flag {}",
+                pair[0]
+            );
+        }
+        let batches = batches.unwrap_or("8").parse()?;
+        ensure!([8, 64].contains(&batches), "batches must be 8 or 64");
+        Ok(Self {
+            manifest: manifest
+                .unwrap_or(".cache/evolution-bench/fixtures/v1/manifest.json")
+                .into(),
+            output: output.context("missing --output")?.into(),
+            batches,
+        })
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+struct DrawingObservation {
+    fitness_bits: u32,
+    geometry_sha256: String,
+}
+
+impl DrawingObservation {
+    fn new(drawing: &Drawing) -> Result<Self> {
+        Ok(Self {
+            // Keep the mapped header's own score, including scores below the
+            // acquisition maximum. Never replace it with snapshot/control data.
+            fitness_bits: drawing.fitness.to_bits(),
+            geometry_sha256: fixtures::sha256(&serde_json::to_vec(&drawing.polygons)?),
+        })
+    }
+}
+
+struct RawEvent {
+    call: u32,
+    drawing: Option<Drawing>,
+    counters: BenchmarkCounters,
+    chain_fitness_bits: [u32; 4],
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+struct Event {
+    call: u32,
+    drawing: Option<DrawingObservation>,
+    counters: BenchmarkCounters,
+    chain_fitness_bits: [u32; 4],
+}
+
+impl RawEvent {
+    fn capture(evolver: &GpuEvolver, call: u32, drawing: Option<Drawing>) -> Self {
+        let mut chain_fitness_bits = [0; 4];
+        for (word, fitness) in chain_fitness_bits.iter_mut().zip(evolver.chain_fitness()) {
+            *word = fitness.to_bits();
+        }
+        Self {
+            call,
+            drawing,
+            counters: evolver.benchmark_counters(),
+            chain_fitness_bits,
+        }
+    }
+
+    fn observe(self) -> Result<Event> {
+        Ok(Event {
+            call: self.call,
+            drawing: self
+                .drawing
+                .as_ref()
+                .map(DrawingObservation::new)
+                .transpose()?,
+            counters: self.counters,
+            chain_fitness_bits: self.chain_fitness_bits,
+        })
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Execution {
+    late_readback: bool,
+    collect_timestamps: bool,
+}
+
+#[derive(Serialize)]
+struct Run {
+    name: String,
+    late_readback: bool,
+    collect_timestamps: bool,
+    events: Vec<Event>,
+    flush: Event,
+    terminal_returned: Option<DrawingObservation>,
+    actual_max_parents: Vec<DrawingObservation>,
+    qualification: TrialRecord,
+}
+
+#[derive(Serialize)]
+struct Report {
+    schema: &'static str,
+    status: &'static str,
+    config: Config,
+    // Both sides use these exact bundled sources and the default true mutation
+    // compilation policy. Only the evolver's host scheduling flag changes.
+    sources: Vec<(&'static str, String)>,
+    mutate_zero_initialize_workgroup_memory: bool,
+    runs: Vec<Run>,
+    errors: Vec<String>,
+}
+
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).take(MAX_ARGS + 1).collect();
+    if args == ["--help"] {
+        println!("{USAGE}");
+        return Ok(());
+    }
+    let config = Config::parse(&args)?;
+    let input = fixtures::load(&config.manifest, "mona")?;
+    validate_fixture(&input)?;
+    fs::create_dir(&config.output).context("output must be a new directory")?;
+    let mut report = Report {
+        schema: "gpu-readback-order-v1",
+        status: "running",
+        config,
+        sources: sources(),
+        mutate_zero_initialize_workgroup_memory: true,
+        runs: Vec::with_capacity(8),
+        errors: Vec::new(),
+    };
+    write_report(&report)?;
+    if let Err(error) = run_checks(&input, &mut report) {
+        report.status = "failed";
+        report.errors.push(format!("{error:#}"));
+    }
+    write_report(&report)?;
+    ensure!(
+        report.status == "passed",
+        "readback check {}: {:?}",
+        report.status,
+        report.errors
+    );
+    Ok(())
+}
+
+fn validate_fixture(input: &LoadedFixture) -> Result<()> {
+    let p = &input.manifest.params;
+    ensure!(
+        input.manifest.resolution == 384
+            && p.chain_count == 4
+            && p.lambda == 64
+            && p.gpu_batch_iters == 64
+            && p.rasterize_wg == [32, 16],
+        "fixed protocol mismatch"
+    );
+    ensure!(
+        input.fixture.complexity.overflowed_tiles == 0,
+        "initial tile overflow"
+    );
+    Ok(())
+}
+
+fn sources() -> Vec<(&'static str, String)> {
+    [
+        ("mutate", include_str!("../src/shaders/mutate.wgsl")),
+        ("bin", include_str!("../src/shaders/bin_polygons.wgsl")),
+        (
+            "raster",
+            include_str!("../src/shaders/rasterize_error.wgsl"),
+        ),
+        ("select", include_str!("../src/shaders/select.wgsl")),
+        (
+            "init",
+            include_str!("../src/shaders/init_framebuffers.wgsl"),
+        ),
+        (
+            "update",
+            include_str!("../src/shaders/update_framebuffers.wgsl"),
+        ),
+    ]
+    .into_iter()
+    .map(|(name, source)| (name, fixtures::sha256(source.as_bytes())))
+    .collect()
+}
+
+fn run_checks(input: &LoadedFixture, report: &mut Report) -> Result<()> {
+    let mut evolver = futures_lite::future::block_on(GpuEvolver::new(
+        &input.rgba,
+        input.fixture.width,
+        input.fixture.height,
+        &input.drawing,
+    ));
+    // Qualify both timestamp paths before exercising either candidate path.
+    for timestamps in [false, true] {
+        let errors = run_pair(
+            &mut evolver,
+            input,
+            report,
+            timestamps,
+            [("aa-first", false), ("aa-repeat", false)],
+        )?;
+        if !errors.is_empty() {
+            report.status = "inconclusive";
+            report.errors.extend(errors);
+            report.errors.push(
+                "strict A/A did not qualify; existing best-ID race was not weakened or repaired"
+                    .into(),
+            );
+            return Ok(());
+        }
+    }
+    for timestamps in [false, true] {
+        let errors = run_pair(
+            &mut evolver,
+            input,
+            report,
+            timestamps,
+            [("baseline", false), ("candidate", true)],
+        )?;
+        report.errors.extend(errors);
+        if !report.errors.is_empty() {
+            report.status = "failed";
+            return Ok(());
+        }
+    }
+    report.status = "passed";
+    Ok(())
+}
+
+fn run_pair(
+    evolver: &mut GpuEvolver,
+    input: &LoadedFixture,
+    report: &mut Report,
+    timestamps: bool,
+    sides: [(&str, bool); 2],
+) -> Result<Vec<String>> {
+    let start = report.runs.len();
+    for (name, late_readback) in sides {
+        report.runs.push(run_once(
+            evolver,
+            input,
+            &report.config,
+            name,
+            Execution {
+                late_readback,
+                collect_timestamps: timestamps,
+            },
+        )?);
+    }
+    let mut errors = compare_runs(&report.runs[start], &report.runs[start + 1]);
+    if report.runs[start..]
+        .iter()
+        .any(|run| !run.qualification.correctness)
+    {
+        errors.push("pair numerical/header/terminal qualification failed".into());
+    }
+    Ok(errors)
+}
+
+fn run_once(
+    evolver: &mut GpuEvolver,
+    input: &LoadedFixture,
+    config: &Config,
+    name: &str,
+    execution: Execution,
+) -> Result<Run> {
+    let output = config.output.join(format!(
+        "{name}-timestamps-{}",
+        execution.collect_timestamps
+    ));
+    fs::create_dir(&output)?;
+    let scopes = evolver.benchmark_error_scopes();
+    let result = execute_run(evolver, input, config, name, execution, &output);
+    let device_errors = futures_lite::future::block_on(scopes.finish());
+    write_json(output.join("device-errors.json"), &device_errors)?;
+    let mut run = result?;
+    run.qualification.errors.extend(device_errors);
+    trial::finish_record(&mut run.qualification);
+    write_json(output.join("result.json"), &run)?;
+    Ok(run)
+}
+
+fn execute_run(
+    evolver: &mut GpuEvolver,
+    input: &LoadedFixture,
+    config: &Config,
+    name: &str,
+    execution: Execution,
+    output: &std::path::Path,
+) -> Result<Run> {
+    let mut qualification = prepare_run(evolver, input, config, execution, output)?;
+    let (raw, raw_flush) =
+        collect_events(evolver, input, config.batches, execution.collect_timestamps);
+    let endpoint = qualify_endpoint(evolver, input, &mut qualification, execution)?;
+    let events = raw
+        .into_iter()
+        .map(RawEvent::observe)
+        .collect::<Result<Vec<_>>>()?;
+    let flush = raw_flush.observe()?;
+    let terminal_returned = flush
+        .drawing
+        .clone()
+        .or_else(|| events.iter().rev().find_map(|e| e.drawing.clone()));
+    let actual_max_parents = maximum_drawings(&endpoint)?;
+    check_events(&events, &flush, &mut qualification.errors);
+    for completed in [3, 6] {
+        if !events
+            .iter()
+            .any(|event| event.counters.completed_batches == completed && event.drawing.is_some())
+        {
+            qualification.errors.push(format!(
+                "missing fixed-case conflict delivery at completed batch {completed}"
+            ));
+        }
+    }
+    if !terminal_returned
+        .as_ref()
+        .is_some_and(|returned| actual_max_parents.contains(returned))
+    {
+        qualification.errors.push(
+            "terminal returned Drawing header/geometry differs from actual maximum parent".into(),
+        );
+    }
+    Ok(Run {
+        name: name.into(),
+        late_readback: evolver.benchmark_late_readback(),
+        collect_timestamps: execution.collect_timestamps,
+        events,
+        flush,
+        terminal_returned,
+        actual_max_parents,
+        qualification,
+    })
+}
+
+fn prepare_run(
+    evolver: &mut GpuEvolver,
+    input: &LoadedFixture,
+    config: &Config,
+    execution: Execution,
+    output: &std::path::Path,
+) -> Result<TrialRecord> {
+    evolver
+        .benchmark_set_late_readback(execution.late_readback)
+        .map_err(anyhow::Error::msg)?;
+    check_mode(evolver, execution.late_readback)?;
+    let spec = TrialSpec {
+        case_id: "mona".into(),
+        seed: 7,
+        batches: config.batches,
+        warmup_batches: 2,
+        diagnostic: false,
+        timestamp_mode: TimestampMode::Stages,
+    };
+    let record = trial::prepare(evolver, input, &spec, output)?;
+    check_mode(evolver, execution.late_readback)?;
+    Ok(record)
+}
+
+fn qualify_endpoint(
+    evolver: &mut GpuEvolver,
+    input: &LoadedFixture,
+    record: &mut TrialRecord,
+    execution: Execution,
+) -> Result<BenchmarkSnapshot> {
+    // collect_events already captured flush_pending's return before this drain.
+    record.counters = evolver.benchmark_drain().map_err(anyhow::Error::msg)?;
+    record.timestamp_samples = evolver.pass_timings().sample_count;
+    let endpoint = evolver
+        .benchmark_snapshot(
+            input.manifest.params.chain_count,
+            input.manifest.params.lambda,
+        )
+        .map_err(anyhow::Error::msg)?;
+    check_mode(evolver, execution.late_readback)?;
+    trial::complete_record(record, &endpoint, input)?;
+    if record.timestamp_samples
+        != if execution.collect_timestamps {
+            u64::from(record.batches)
+        } else {
+            0
+        }
+    {
+        record.errors.push("timestamp sample count mismatch".into());
+    }
+    Ok(endpoint)
+}
+
+fn check_mode(evolver: &GpuEvolver, late: bool) -> Result<()> {
+    ensure!(
+        evolver.benchmark_late_readback() == late,
+        "installed late-readback mode changed"
+    );
+    ensure!(
+        evolver.benchmark_mutate_shader_matches(
+            include_str!("../src/shaders/mutate.wgsl"),
+            BenchmarkMutateOptions::default()
+        ),
+        "mutation source/options changed"
+    );
+    Ok(())
+}
+
+fn collect_events(
+    evolver: &mut GpuEvolver,
+    input: &LoadedFixture,
+    batches: u32,
+    timestamps: bool,
+) -> (Vec<RawEvent>, RawEvent) {
+    let mut events = Vec::with_capacity(batches as usize);
+    for call in 1..=batches {
+        let drawing = evolver.run_batch(&input.manifest.params, timestamps);
+        events.push(RawEvent::capture(evolver, call, drawing));
+    }
+    let drawing = evolver.flush_pending();
+    let flush = RawEvent::capture(evolver, batches + 1, drawing);
+    (events, flush)
+}
+
+fn maximum_drawings(snapshot: &BenchmarkSnapshot) -> Result<Vec<DrawingObservation>> {
+    let maximum = snapshot
+        .parents
+        .iter()
+        .map(|p| p.fitness_bits)
+        .max()
+        .context("no parents")?;
+    snapshot
+        .parents
+        .iter()
+        .filter(|p| p.fitness_bits == maximum)
+        .map(observe_parent)
+        .collect()
+}
+
+fn observe_parent(parent: &BenchmarkPackedState) -> Result<DrawingObservation> {
+    let mut state = GpuDrawingState::zeroed();
+    state.polygon_count = parent.polygon_count;
+    state.fitness_bits = parent.fitness_bits;
+    for (polygon, data) in state.polygons.iter_mut().zip(&parent.polygons) {
+        *polygon = GpuPolygon { data: *data };
+    }
+    DrawingObservation::new(&gpu_to_drawing(&state))
+}
+
+fn check_events(events: &[Event], flush: &Event, errors: &mut Vec<String>) {
+    if !events.iter().any(|e| e.drawing.is_none()) || !events.iter().any(|e| e.drawing.is_some()) {
+        errors.push("ordinary Some/None coverage missing".into());
+    }
+    for event in events.iter().chain(std::iter::once(flush)) {
+        if let Some(drawing) = &event.drawing {
+            if !f32::from_bits(drawing.fitness_bits).is_finite()
+                || !event.chain_fitness_bits.contains(&drawing.fitness_bits)
+            {
+                errors.push(format!(
+                    "call {} returned header not present in collected chain fitness",
+                    event.call
+                ));
+            }
+        }
+    }
+}
+
+fn compare_runs(expected: &Run, actual: &Run) -> Vec<String> {
+    let mut errors = Vec::new();
+    if expected.qualification.initial_state_sha256 != actual.qualification.initial_state_sha256
+        || expected.qualification.final_state_sha256 != actual.qualification.final_state_sha256
+    {
+        errors.push("seven-field canonical state differs".into());
+    }
+    compare_events(&expected.events, &actual.events, &mut errors);
+    if expected.flush != actual.flush || expected.terminal_returned != actual.terminal_returned {
+        errors.push("terminal flush/returned Drawing differs".into());
+    }
+    if expected.qualification.counters != actual.qualification.counters
+        || expected.qualification.timestamp_samples != actual.qualification.timestamp_samples
+    {
+        errors.push("completed work/timestamp accounting differs".into());
+    }
+    errors
+}
+
+fn compare_events(expected: &[Event], actual: &[Event], errors: &mut Vec<String>) {
+    if expected != actual {
+        errors.push(
+            "ordinary Some/None, own header/geometry, chain fitness or copied counters differ"
+                .into(),
+        );
+    }
+}
+
+fn write_report(report: &Report) -> Result<()> {
+    write_json(report.config.output.join("summary.json"), report)
+}
+
+fn write_json(path: PathBuf, value: &impl Serialize) -> Result<()> {
+    let bytes = serde_json::to_vec_pretty(value)?;
+    ensure!(bytes.len() <= MAX_JSON_BYTES, "JSON exceeds 2 MiB");
+    fs::write(path, bytes)?;
+    Ok(())
+}
