+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cli_bounds_the_fixed_workload() -> Result<()> {
+        let args = ["--output", "new-dir"].map(str::to_owned);
+        assert_eq!(Config::parse(&args)?.batches, 8);
+        for value in ["0", "7", "9", "65", "garbage"] {
+            let mut invalid = args.to_vec();
+            invalid.extend(["--batches".into(), value.into()]);
+            assert!(Config::parse(&invalid).is_err());
+        }
+        let mut duplicate = args.to_vec();
+        duplicate.extend(args.clone());
+        assert!(Config::parse(&duplicate).is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn ordinary_comparison_rejects_delivery_header_geometry_fitness_and_counters() {
+        let original = Event {
+            call: 4,
+            drawing: Some(DrawingObservation {
+                fitness_bits: 98.0f32.to_bits(),
+                geometry_sha256: "copied-drawing".into(),
+            }),
+            counters: BenchmarkCounters {
+                completed_batches: 3,
+                ..Default::default()
+            },
+            chain_fitness_bits: [98.0f32.to_bits(), 99.0f32.to_bits(), 0, 0],
+        };
+        let mut errors = Vec::new();
+        compare_events(&[original.clone()], &[original.clone()], &mut errors);
+        assert!(errors.is_empty());
+        for changed in 0..5 {
+            let mut event = original.clone();
+            match changed {
+                0 => event.drawing = None,
+                1 => event.drawing.as_mut().unwrap().fitness_bits = 99.0f32.to_bits(),
+                2 => event.drawing.as_mut().unwrap().geometry_sha256 = "other".into(),
+                3 => event.chain_fitness_bits[0] = 97.0f32.to_bits(),
+                _ => event.counters.completed_batches = 4,
+            }
+            let mut failures = Vec::new();
+            compare_events(&[original.clone()], &[event], &mut failures);
+            assert!(!failures.is_empty());
+        }
+    }
+
+    #[test]
+    fn header_membership_preserves_scores_below_acquisition_maximum() {
+        let own = 98.0f32.to_bits();
+        let some = Event {
+            call: 4,
+            drawing: Some(DrawingObservation {
+                fitness_bits: own,
+                geometry_sha256: "own".into(),
+            }),
+            counters: Default::default(),
+            chain_fitness_bits: [own, 99.0f32.to_bits(), 0, 0],
+        };
+        let mut none = some.clone();
+        none.drawing = None;
+        let mut errors = Vec::new();
+        check_events(&[none.clone(), some.clone()], &none, &mut errors);
+        assert!(errors.is_empty());
+        let mut wrong = some;
+        wrong.drawing.as_mut().unwrap().fitness_bits = 97.0f32.to_bits();
+        check_events(&[none.clone(), wrong], &none, &mut errors);
+        assert_eq!(errors.len(), 1);
+    }
