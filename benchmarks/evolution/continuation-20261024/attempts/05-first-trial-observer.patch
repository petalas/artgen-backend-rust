+    evidence: Option<Evidence>,
+    elapsed_seconds: Option<f64>,
+    measurement: Interval,
+    drain: Drain,
+    preparation_before: Lifetime,
+    preparation_after: Lifetime,
+    lifetime_before: Lifetime,
+    lifetime_after: Option<Lifetime>,
+    split_count: u64,
+    split_batch_ids: Vec<u64>,
+    batches: Vec<Batch>,
+    readbacks: Vec<Readback>,
+    checked_counters: Option<BenchmarkCounters>,
+    #[serde(skip)]
+    runtime: Runtime,
+}
+
+struct Runtime {
+    epoch: Option<Instant>,
+    active: bool,
+    collection: &'static str,
+    current_readback: Option<usize>,
+}
+
+#[derive(Default)]
+pub(super) struct Observer {
+    data: RefCell<Option<Data>>,
+    exported_rows: Cell<usize>,
+    previous_lifetime: Cell<Option<Lifetime>>,
+    fingerprint: RefCell<Option<String>>,
+}
+
+impl Observer {
+    pub(super) fn now(&self) -> Option<u64> {
+        let borrow = self.data.borrow();
+        let d = borrow.as_ref()?;
+        if !d.runtime.active {
+            return None;
+        }
+        u64::try_from(d.runtime.epoch?.elapsed().as_nanos()).ok()
+    }
+
+    pub(super) fn collection(&self, name: &'static str) {
+        if let Some(d) = self.data.borrow_mut().as_mut() {
+            d.runtime.collection = name;
+        }
+    }
+
+    pub(super) fn guard(&self, guard: Guard, target: Option<u64>) {
+        if let Some(d) = self.data.borrow_mut().as_mut().filter(|d| d.runtime.active) {
+            if let Some(row) = d.batches.last_mut() {
+                if row.guard.is_some() {
+                    d.overflow = true;
+                    return;
+                }
+                d.overflow |= row.previous_target_id != target;
+                row.guard = Some(guard);
+            } else {
+                d.overflow = true;
+            }
+        }
+    }
+
+    pub(super) fn split(&self, ordinal: u64) {
+        if let Some(d) = self.data.borrow_mut().as_mut().filter(|d| d.runtime.active) {
+            if let Some(row) = d.batches.last_mut() {
+                d.overflow |= row.split_taken;
+                row.split_taken = true;
+                row.true_execution_ordinal = Some(ordinal);
+                d.split_count = d.split_count.saturating_add(1);
+                if d.split_batch_ids.len() < BATCHES {
+                    d.split_batch_ids.push(row.id);
+                } else {
+                    d.overflow = true;
+                }
+            } else {
+                d.overflow = true;
+            }
+        }
+    }
+
+    pub(super) fn two_buffer_submit(&self) {
+        if let Some(d) = self.data.borrow_mut().as_mut().filter(|d| d.runtime.active) {
+            if let Some(row) = d.batches.last_mut() {
+                d.overflow |= row.two_buffer_submit_completed;
+                row.two_buffer_submit_completed = true;
+            } else {
+                d.overflow = true;
+            }
+        }
+    }
+
+    pub(super) fn batch_span(&self, name: &'static str, start: Option<u64>) {
+        let (Some(end), Some(start)) = (self.now(), start) else {
+            return;
+        };
+        let mut borrow = self.data.borrow_mut();
+        let d = borrow.as_mut().expect("active observer");
+        if d.overflow {
+            return;
+        }
+        if let Some(row) = d.batches.last_mut() {
+            d.overflow |= !store(
+                &mut row.spans,
+                Span {
+                    name,
+                    start_ns: start,
+                    end_ns: end,
+                },
+            );
+        } else {
+            d.overflow = true;
+        }
+    }
+
+    pub(super) fn readback_begin(&self, id: u64, staging: Option<usize>, sync: bool) {
+        let Some(start) = self.now() else {
+            return;
+        };
+        let mut borrow = self.data.borrow_mut();
+        let d = borrow.as_mut().expect("active observer");
+        d.overflow |= d.runtime.current_readback.is_some();
+        d.runtime.current_readback = None;
+        if d.readbacks.len() >= READBACKS {
+            d.overflow = true;
+            return;
+        }
+        let parent = d.batches.last().map_or(0, |row| row.id);
+        d.runtime.current_readback = Some(d.readbacks.len());
+        d.readbacks.push(Readback {
+            target_batch_id: id,
+            caller_batch_id: parent,
+            collection: d.runtime.collection,
+            synchronous_fallback: sync,
+            staging_index: staging,
+            start_ns: start,
+            end_ns: None,
+            spans: [None; SPANS],
+        });
+    }
+
+    pub(super) fn readback_span(&self, name: &'static str, start: Option<u64>) {
+        let (Some(end), Some(start)) = (self.now(), start) else {
+            return;
+        };
+        let mut borrow = self.data.borrow_mut();
+        let d = borrow.as_mut().expect("active observer");
+        if let Some(index) = d.runtime.current_readback {
+            d.overflow |= !store(
+                &mut d.readbacks[index].spans,
+                Span {
+                    name,
+                    start_ns: start,
+                    end_ns: end,
+                },
+            );
+        } else {
+            d.overflow = true;
+        }
+    }
+
+    pub(super) fn readback_end(&self) {
+        let Some(end) = self.now() else {
+            return;
+        };
+        let mut borrow = self.data.borrow_mut();
+        let d = borrow.as_mut().expect("active observer");
+        if let Some(index) = d.runtime.current_readback.take() {
+            let row = &mut d.readbacks[index];
+            row.end_ns = Some(end);
+            if !row.synchronous_fallback {
+                let target = usize::try_from(row.target_batch_id.saturating_sub(1)).ok();
+                if let Some(batch) = target.and_then(|i| d.batches.get_mut(i)) {
+                    d.overflow |= batch.completion_end_ns.is_some();
+                    batch.completion_start_ns = Some(row.start_ns);
+                    batch.completion_end_ns = Some(end);
+                    batch.completion_collection = Some(row.collection);
+                } else {
+                    d.overflow = true;
+                }
+            }
+        } else {
+            d.overflow = true;
+        }
+    }
+}
+
+fn store(slots: &mut [Option<Span>; SPANS], span: Span) -> bool {
+    for slot in slots.iter_mut() {
+        if slot.is_none() {
+            *slot = Some(span);
+            return true;
+        }
+    }
+    false
+}
+
+#[must_use]
+pub fn lifetime(e: &GpuEvolver) -> Lifetime {
+    e.first_use_lifetime
+}
+
+fn bounded_batches(batches: u32) -> Result<usize> {
+    ensure!(
+        (1..=64).contains(&batches),
+        "first-use batches outside 1..64"
+    );
+    Ok(usize::try_from(batches)?)
+}
+
+fn new_data(n: usize, before: Lifetime, after: Lifetime) -> Data {
+    Data {
+        schema: "first-use-engine-lab-v1", score_eligible: false, provenance_sha256: SOURCE.trim(),
+        interpretation: "elapsed host-thread intervals including off-CPU waits; not CPU time or savings",
+        warmup_spans: "excluded",
+        lifetime_scope: "one evolver from construction, including untimed work; never reset by seeded restart",
+        clock_boundary: "epoch is original measure Instant; end follows original elapsed capture; overhead and gaps uncalibrated",
+        nesting: "direct spans nest in batch; readback spans nest in collection or drain; do not sum inclusive parents or CPU/GPU intervals",
+        expected_batches: n, valid: false, overflow: false, errors: Vec::new(), evidence: None,
+        elapsed_seconds: None, measurement: Interval::default(), drain: Drain::default(),
+        preparation_before: before, preparation_after: after,
+        lifetime_before: after, lifetime_after: None, split_count: 0,
+        split_batch_ids: Vec::with_capacity(BATCHES), batches: Vec::with_capacity(BATCHES),
+        readbacks: Vec::with_capacity(READBACKS), checked_counters: None,
+        runtime: Runtime { epoch: None, active: false, collection: "unassigned", current_readback: None },
+    }
+}
+
+/// Allocation and boundary checks occur before the original measured clock.
+/// # Errors
+/// Rejects a batch count outside 1..64, unprepared state or an unexported capture.
+pub fn prepare(e: &GpuEvolver, batches: u32, before: Lifetime, after: Lifetime) -> Result<()> {
+    let n = bounded_batches(batches)?;
+    ensure!(
+        e.pending_batch.is_none() && e.framebuffers_initialized,
+        "unprepared measurement"
+    );
+    ensure!(
+        e.benchmark_counters == BenchmarkCounters::default(),
+        "measurement counters not reset"
+    );
+    ensure!(
+        e.first_use.data.borrow().is_none(),
+        "previous capture not exported"
+    );
+    ensure!(after == lifetime(e), "work between preparation and arm");
+    *e.first_use.data.borrow_mut() = Some(new_data(n, before, after));
+    Ok(())
+}
+
+pub fn start(e: &GpuEvolver, epoch: Instant) {
+    if let Some(d) = e.first_use.data.borrow_mut().as_mut() {
+        d.runtime.epoch = Some(epoch);
+        d.runtime.active = true;
+        d.lifetime_before = lifetime(e);
+    }
+}
+
+pub fn batch_begin(e: &GpuEvolver) {
+    let Some(now) = e.first_use.now() else {
+        return;
+    };
+    let mut borrow = e.first_use.data.borrow_mut();
+    let d = borrow.as_mut().expect("active observer");
+    if d.batches.len() >= BATCHES {
+        d.overflow = true;
+        return;
+    }
+    d.overflow |= d.batches.last().is_some_and(|row| row.end_ns.is_none());
+    let c = e.benchmark_counters;
+    d.batches.push(Batch {
+        id: c.submitted_batches + 1,
+        previous_target_id: e.pending_batch.as_ref().map(|_| c.completed_batches + 1),
+        staging_index: e.staging_idx,
+        iteration_before: e.iteration,
+        iteration_after: None,
+        counters_before: c,
+        counters_after: None,
+        lifetime_before: lifetime(e),
+        lifetime_after: None,
+        guard: None,
+        split_taken: false,
+        true_execution_ordinal: None,
+        two_buffer_submit_completed: false,
+        completion_start_ns: None,
+        completion_end_ns: None,
+        completion_collection: None,
+        start_ns: now,
+        end_ns: None,
+        spans: [None; SPANS],
+    });
+}
+
+pub fn batch_end(e: &GpuEvolver) {
+    let Some(now) = e.first_use.now() else {
+        return;
+    };
+    let mut borrow = e.first_use.data.borrow_mut();
+    let d = borrow.as_mut().expect("active observer");
+    if d.overflow {
+        return;
+    }
+    if let Some(row) = d.batches.last_mut() {
+        if row.end_ns.is_some() {
+            d.overflow = true;
+            return;
+        }
+        row.end_ns = Some(now);
+        row.iteration_after = Some(e.iteration);
+        row.counters_after = Some(e.benchmark_counters);
+        row.lifetime_after = Some(lifetime(e));
+    } else {
+        d.overflow = true;
+    }
+}
+
+pub fn drain_begin(e: &GpuEvolver) {
+    let Some(now) = e.first_use.now() else {
+        return;
+    };
+    let mut borrow = e.first_use.data.borrow_mut();
+    let d = borrow.as_mut().expect("active observer");
+    d.runtime.collection = "final_drain";
+    d.drain.start_ns = now;
+}
+
+/// Stop only after the original elapsed capture, including a returned drain error.
+pub fn end(e: &GpuEvolver, elapsed: f64, checked: &std::result::Result<BenchmarkCounters, String>) {
+    let Some(now) = e.first_use.now() else {
+        return;
+    };
+    let mut borrow = e.first_use.data.borrow_mut();
+    let d = borrow.as_mut().expect("active observer");
+    d.measurement.end_ns = Some(now);
+    d.drain.end_ns = Some(now);
+    d.elapsed_seconds = Some(elapsed);
+    d.lifetime_after = Some(lifetime(e));
+    d.runtime.active = false;
+    match checked {
+        Ok(c) => {
+            d.checked_counters = Some(*c);
+            d.drain.status = "checked";
+        }
+        Err(error) => {
+            d.drain.status = "failed";
+            d.errors.push(format!("checked drain failed: {error}"));
+        }
+    }
+}
+
+const SINGLE: &[&str] = &[
+    "previous_collection",
+    "parameter_upload",
+    "compute_recording",
+    "tail_recording",
+    "final_finish",
+    "queue_submit",
+    "postsubmit_collection",
+    "map_registration",
+];
+const SPLIT: &[&str] = &[
+    "compute_recording",
+    "prefix_finish",
+    "previous_collection",
+    "parameter_upload",
+    "tail_encoder_acquisition",
+    "tail_recording",
+    "final_finish",
+    "queue_submit",
+    "postsubmit_collection",
+    "map_registration",
+];
+const ASYNC: &[&str] = &[
+    "poll_wait",
+    "control_receive",
+    "timestamp_receive",
+    "fitness_receive",
+    "control_decode_drop",
+    "timestamp_decode_drop_unmap",
+    "fitness_decode_drop",
+    "remaining_unmaps_best_state",
+];
+const DRAWING: &[&str] = &[
+    "poll_wait",
+    "control_receive",
+    "timestamp_receive",
+    "fitness_receive",
+    "drawing_receive",
+    "drawing_decode_drop_unmap",
+    "control_decode_drop",
+    "timestamp_decode_drop_unmap",
+    "fitness_decode_drop",
+    "remaining_unmaps_best_state",
+];
+const SYNC: &[&str] = &[
+    "front_end_copy_recording",
+    "final_finish",
+    "queue_submit",
+    "map_registration",
+    "poll_wait",
+    "drawing_receive",
+    "drawing_decode_drop_unmap",
+];
+
+fn valid_spans(slots: &[Option<Span>; SPANS], names: &[&str], start: u64, end: u64) -> bool {
+    if start > end || names.len() > SPANS {
+        return false;
+    }
+    let mut previous = start;
+    for (index, slot) in slots.iter().enumerate() {
+        match (slot, names.get(index)) {
+            (Some(span), Some(name))
+                if span.name == *name
+                    && previous <= span.start_ns
+                    && span.start_ns <= span.end_ns
+                    && span.end_ns <= end =>
+            {
+                previous = span.end_ns;
+            }
+            (None, None) => {}
+            _ => return false,
+        }
+    }
+    true
+}
+
+fn work(batches: u64) -> BenchmarkCounters {
+    BenchmarkCounters {
+        submitted_batches: batches,
+        completed_batches: batches,
+        submitted_iterations: batches * 64,
+        completed_iterations: batches * 64,
+        submitted_evaluations: batches * 16384,
+        completed_evaluations: batches * 16384,
+    }
+}
+
+fn valid_counter(c: BenchmarkCounters, submitted: u64, completed: u64) -> bool {
+    let a = work(submitted);
+    let b = work(completed);
+    c.submitted_batches == a.submitted_batches
+        && c.submitted_iterations == a.submitted_iterations
+        && c.submitted_evaluations == a.submitted_evaluations
+        && c.completed_batches == b.completed_batches
+        && c.completed_iterations == b.completed_iterations
+        && c.completed_evaluations == b.completed_evaluations
+}
+
+fn advance(before: Lifetime, evaluations: u64, splits: u64) -> Option<Lifetime> {
+    Some(Lifetime {
+        guard_evaluations: before.guard_evaluations.checked_add(evaluations)?,
+        true_executions: before.true_executions.checked_add(splits)?,
+        two_buffer_submits: before.two_buffer_submits.checked_add(splits)?,
+    })
+}
+
+fn valid_lifetime(c: Lifetime) -> bool {
+    c.two_buffer_submits == c.true_executions && c.true_executions <= c.guard_evaluations
+}
+
+fn valid_batch(d: &Data, b: &Batch, index: usize) -> bool {
+    let id = index as u64 + 1;
+    let (Some(end), Some(after), Some(guard)) = (b.end_ns, b.counters_after, b.guard) else {
+        return false;
+    };
+    let split = u64::from(b.split_taken);
+    let previous = id.checked_sub(1).filter(|v| *v > 0);
+    let expected_before = if index == 0 {
+        Some(d.lifetime_before)
+    } else {
+        d.batches[index - 1].lifetime_after
+    };
+    let enabled = d
+        .evidence
+        .as_ref()
+        .is_some_and(|e| e.identity.finalize_overlap);
+    b.id == id
+        && b.staging_index < 2
+        && b.previous_target_id == previous
+        && (index == 0 || b.staging_index != d.batches[index - 1].staging_index)
+        && b.iteration_before == u32::try_from((id - 1) * 64).expect("bounded batch")
+        && b.iteration_after == u32::try_from(id * 64).ok()
+        && valid_counter(b.counters_before, id - 1, id.saturating_sub(2))
+        && valid_counter(after, id, id - 1)
+        && expected_before == Some(b.lifetime_before)
+        && valid_lifetime(b.lifetime_before)
+        && b.lifetime_after == advance(b.lifetime_before, 1, split)
+        && guard.enabled == enabled
+        && guard.readback.previous_pending == previous.is_some()
+        && guard.taken() == b.split_taken
+        && b.two_buffer_submit_completed == b.split_taken
+        && b.true_execution_ordinal
+            == (if b.split_taken {
+                b.lifetime_before.true_executions.checked_add(1)
+            } else {
+                None
+            })
+        && valid_spans(
+            &b.spans,
+            if b.split_taken { SPLIT } else { SINGLE },
+            b.start_ns,
+            end,
+        )
+}
+
+fn valid_readback(d: &Data, row: &Readback) -> bool {
+    let n = d.expected_batches as u64;
+    if !(1..=n).contains(&row.target_batch_id) || !(1..=n).contains(&row.caller_batch_id) {
+        return false;
+    }
+    let Some(end) = row.end_ns else {
+        return false;
+    };
+    let target = &d.batches[usize::try_from(row.target_batch_id).expect("bounded target") - 1];
+    let names = if row.synchronous_fallback {
+        SYNC
+    } else if row.spans[4].is_some_and(|s| s.name == "drawing_receive") {
+        DRAWING
+    } else {
+        ASYNC
+    };
+    if !valid_spans(&row.spans, names, row.start_ns, end) {
+        return false;
+    }
+    let bounds = collection_bounds(d, row);
+    let Some((start, parent_end)) = bounds else {
+        return false;
+    };
+    start <= row.start_ns
+        && end <= parent_end
+        && target.end_ns.is_some_and(|end| end <= row.start_ns)
+        && if row.synchronous_fallback {
+            row.staging_index.is_none()
+                && row.target_batch_id == n
+                && d.checked_counters
+                    .is_some_and(|c| c.completed_batches == row.target_batch_id)
+        } else {
+            row.staging_index == Some(target.staging_index)
+                && target.completion_start_ns == Some(row.start_ns)
+                && target.completion_end_ns == Some(end)
+                && target.completion_collection == Some(row.collection)
+        }
+}
+
+fn collection_bounds(d: &Data, row: &Readback) -> Option<(u64, u64)> {
+    let n = d.expected_batches as u64;
+    match row.collection {
+        "final_drain" if row.caller_batch_id == n && row.target_batch_id == n => {
+            d.drain.end_ns.map(|end| (d.drain.start_ns, end))
+        }
+        "previous_collection" | "postsubmit_collection"
+            if !row.synchronous_fallback && row.target_batch_id + 1 == row.caller_batch_id =>
+        {
+            let parent =
+                &d.batches[usize::try_from(row.caller_batch_id).expect("bounded caller") - 1];
+            let guard = parent.guard?;
+            let early = guard.readback.pending_best
+                && guard.readback.deferred_readback
+                && guard.readback.previous_pending;
+            if parent.previous_target_id != Some(row.target_batch_id)
+                || early != (row.collection == "previous_collection")
+            {
+                return None;
+            }
+            parent
+                .spans
+                .iter()
+                .flatten()
+                .find(|span| span.name == row.collection)
+                .map(|s| (s.start_ns, s.end_ns))
+        }
+        _ => None,
+    }
+}
+
+fn hash(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+
+fn valid_identity(e: &Evidence, row: usize, n: u64) -> bool {
+    let i = &e.identity;
+    let variants = ["reference", "overlap", "overlap", "reference"];
+    row < 4
+        && i.row_index == row
+        && hash(&i.invocation_id)
+        && i.case == "mona"
+        && i.variant == variants[row]
+        && i.candidate == "overlap"
+        && Some(i.pair) == u32::try_from(row / 2).ok()
+        && Some(i.order) == u32::try_from(row % 2).ok()
+        && i.seed == 7
+        && i.warmup_batches == 2
+        && i.timestamp_mode == "stages"
+        && i.finalize_overlap == (i.variant == "overlap")
+        && e.timestamp_samples == n
+        && e.counters == work(n)
+        && e.row_errors.is_empty()
+        && hash(&e.initial_state_sha256)
+        && hash(&e.final_state_sha256)
+        && hash(&e.params_sha256)
+        && e.fixture_manifest_sha256
+            == "82dfe207ecd20ae964edf4528f1a90fe4176b21f4ac0911b305da1e1edf1c5aa"
+        && e.source_sha256 == "ae1fd75fdc118debf2a50cbad699e513b5af0dcbfa3754b45966f7a8ee925af3"
+}
+
+/// Validate once after measurement. Captured rows are never repaired or removed.
+fn validate(d: &Data, row: usize, prior: Option<Lifetime>) -> bool {
+    let n = d.expected_batches;
+    let (Some(end), Some(drain_end), Some(after), Some(e)) = (
+        d.measurement.end_ns,
+        d.drain.end_ns,
+        d.lifetime_after,
+        d.evidence.as_ref(),
+    ) else {
+        return false;
+    };
+    if !(1..=BATCHES).contains(&n)
+        || d.runtime.active
+        || d.overflow
+        || d.runtime.current_readback.is_some()
+        || d.drain.status != "checked"
+        || !d.errors.is_empty()
+        || d.batches.len() != n
+        || !(n..=n + 1).contains(&d.readbacks.len())
+        || d.measurement.start_ns != 0
+        || d.drain.start_ns > drain_end
+        || drain_end != end
+        || end > 120_000_000_000
+        || !d.elapsed_seconds.is_some_and(|v| {
+            v.is_finite() && v > 0.0 && v <= std::time::Duration::from_nanos(end).as_secs_f64()
+        })
+        || d.checked_counters != Some(work(n as u64))
+        || !valid_identity(e, row, n as u64)
+        || !hash(d.provenance_sha256)
+        || !valid_lifetime(d.preparation_before)
+        || !valid_lifetime(d.preparation_after)
+        || d.preparation_after != d.lifetime_before
+        || d.preparation_after
+            .guard_evaluations
+            .checked_sub(d.preparation_before.guard_evaluations)
+            != Some(2)
+        || !valid_preparation(d, prior)
+        || advance(d.lifetime_before, n as u64, d.split_count) != Some(after)
+    {
+        return false;
+    }
+    valid_batches(d) && valid_completions(d)
+}
+
+fn valid_batches(d: &Data) -> bool {
+    let mut previous = 0;
+    let mut split_ids = [0; BATCHES];
+    let mut split_count = 0;
+    for (index, batch) in d.batches.iter().enumerate() {
+        if previous > batch.start_ns
+            || batch.end_ns.is_none_or(|v| v > d.drain.start_ns)
+            || !valid_batch(d, batch, index)
+        {
+            return false;
+        }
+        previous = batch.end_ns.expect("validated end");
+        if batch.split_taken {
+            split_ids[split_count] = batch.id;
+            split_count += 1;
+        }
+    }
+    d.split_count == split_count as u64
+        && d.split_batch_ids == split_ids[..split_count]
+        && d.batches.last().and_then(|b| b.lifetime_after) == d.lifetime_after
+}
+
+fn valid_completions(d: &Data) -> bool {
+    let n = d.expected_batches;
+    let mut completed = [false; BATCHES];
+    let mut previous = 0;
+    let mut sync = false;
+    for row in &d.readbacks {
+        if previous > row.start_ns || !valid_readback(d, row) {
+            return false;
+        }
+        previous = row.end_ns.expect("validated end");
+        if row.synchronous_fallback {
+            if sync || !completed[..n].iter().all(|v| *v) {
+                return false;
+            }
+            sync = true;
+        } else {
+            let index = usize::try_from(row.target_batch_id).expect("bounded target") - 1;
+            if completed[index]
+                || row.target_batch_id != completed[..n].iter().filter(|v| **v).count() as u64 + 1
+            {
+                return false;
+            }
+            completed[index] = true;
+        }
+    }
+    completed[..n].iter().all(|v| *v)
+}
+
+fn valid_preparation(d: &Data, prior: Option<Lifetime>) -> bool {
+    let a = d.preparation_before;
+    let b = d.preparation_after;
+    let Some(splits) = b.true_executions.checked_sub(a.true_executions) else {
+        return false;
+    };
+    splits <= 2 && advance(a, 2, splits) == Some(b) && prior.is_none_or(|p| p == a)
+}
+
+/// Streaming cap applies to actual bytes written. Short writes are handled by `Write::write_all`.
+struct LimitedWriter<W> {
+    inner: W,
+    bytes: usize,
+}
+impl<W: Write> Write for LimitedWriter<W> {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        if bytes.len() > JSON_LIMIT - self.bytes {
+            return Err(std::io::Error::other("first-use JSON exceeds 2 MiB"));
+        }
+        let count = self.inner.write(bytes)?;
+        if count > bytes.len() {
+            return Err(std::io::Error::other("writer returned impossible length"));
+        }
+        self.bytes += count;
+        Ok(count)
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.inner.flush()
+    }
+}
+
+fn write_json(d: &Data, writer: impl Write) -> Result<()> {
+    let mut writer = LimitedWriter {
+        inner: writer,
+        bytes: 0,
+    };
+    serde_json::to_writer(&mut writer, d)?;
+    writer.flush()?;
+    Ok(())
+}
+
+fn fingerprint(e: &Evidence) -> String {
+    format!(
+        "{}:{}:{}:{}:{}:{}",
+        e.identity.invocation_id,
+        e.initial_state_sha256,
+        e.final_state_sha256,
+        e.params_sha256,
+        e.source_sha256,
+        e.fixture_manifest_sha256
+    )
+}
+
+fn export_with<W: Write>(
+    d: &mut Data,
+    path: &Path,
+    row: usize,
+    prior: Option<Lifetime>,
+    previous_fingerprint: Option<&str>,
+    wrap: impl FnOnce(std::fs::File) -> W,
+) -> Result<()> {
+    d.valid = validate(d, row, prior)
+        && d.evidence.as_ref().is_some_and(|e| {
+            previous_fingerprint.is_none_or(|previous| previous == fingerprint(e))
+        });
+    if !d.valid && d.errors.len() < 32 {
+        d.errors
+            .push("invalid first-use capture; original rows retained".into());
+    }
+    let file = OpenOptions::new().write(true).create_new(true).open(path)?;
+    write_json(d, wrap(file))?;
+    ensure!(
+        d.valid,
+        "invalid first-use diagnostic retained at {}",
+        path.display()
+    );
+    Ok(())
+}
+
+fn export_data(
+    d: &mut Data,
+    path: &Path,
+    row: usize,
+    prior: Option<Lifetime>,
+    previous_fingerprint: Option<&str>,
+) -> Result<()> {
+    export_with(d, path, row, prior, previous_fingerprint, |file| file)
+}
+
+/// Export after row identity and device errors have been assigned.
+/// # Errors
+/// Retains invalid or partial files and returns validation, no-replace or write failures.
+pub fn export(e: &GpuEvolver, path: &Path, evidence: Evidence) -> Result<()> {
+    let mut d = e
+        .first_use
+        .data
+        .borrow_mut()
+        .take()
+        .ok_or_else(|| anyhow::anyhow!("missing first-use capture"))?;
+    d.evidence = Some(evidence);
+    let row = e.first_use.exported_rows.get();
+    let previous = e.first_use.fingerprint.borrow();
+    let result = export_data(
+        &mut d,
+        path,
+        row,
+        e.first_use.previous_lifetime.get(),
+        previous.as_deref(),
+    );
+    drop(previous);
+    if row == 0 {
+        *e.first_use.fingerprint.borrow_mut() = d.evidence.as_ref().map(fingerprint);
+    }
+    e.first_use.previous_lifetime.set(d.lifetime_after);
+    e.first_use.exported_rows.set(row.saturating_add(1));
+    result
+}
