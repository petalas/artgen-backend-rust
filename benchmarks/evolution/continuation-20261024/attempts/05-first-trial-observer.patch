+    fn link_completions(d: &mut Data) {
+        for index in 0..d.expected_batches {
+            let target = index as u64 + 1;
+            let (caller, collection, start) = if index + 1 == d.expected_batches {
+                (target, "final_drain", d.drain.start_ns + 20)
+            } else {
+                let parent = &d.batches[index + 1];
+                let guard = parent.guard.unwrap();
+                let early = guard.readback.pending_best && guard.readback.deferred_readback;
+                let name = if early {
+                    "previous_collection"
+                } else {
+                    "postsubmit_collection"
+                };
+                let span = parent
+                    .spans
+                    .iter()
+                    .flatten()
+                    .find(|s| s.name == name)
+                    .unwrap();
+                (target + 1, name, span.start_ns + 20)
+            };
+            d.batches[index].completion_start_ns = Some(start);
+            d.batches[index].completion_end_ns = Some(start + 99);
+            d.batches[index].completion_collection = Some(collection);
+            d.readbacks.push(Readback {
+                target_batch_id: target,
+                caller_batch_id: caller,
+                collection,
+                synchronous_fallback: false,
+                staging_index: Some(d.batches[index].staging_index),
+                start_ns: start,
+                end_ns: Some(start + 99),
+                spans: spans(ASYNC, start, 10),
+            });
+        }
+    }
