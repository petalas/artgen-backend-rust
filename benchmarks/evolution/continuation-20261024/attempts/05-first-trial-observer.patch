+            counters_after: Some(BenchmarkCounters {
+                completed_batches: id - 1,
+                completed_iterations: (id - 1) * 64,
+                completed_evaluations: (id - 1) * 16384,
+                ..work(id)
+            }),
+            lifetime_before: current,
+            lifetime_after: Some(next),
+            guard: Some(Guard {
+                enabled,
+                readback: ReadbackGuard {
+                    pending_best: conflict,
+                    deferred_readback: conflict,
+                    previous_pending: id > 1,
+                },
+            }),
+            split_taken: split,
+            true_execution_ordinal: split.then_some(next.true_executions),
+            two_buffer_submit_completed: split,
+            completion_start_ns: None,
+            completion_end_ns: None,
+            completion_collection: None,
