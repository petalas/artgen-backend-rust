+        let mut d = observer.data.into_inner().unwrap();
+        d.runtime.active = false;
+        let j = exported(d, "span-capacity", false);
+        assert_eq!(
+            j["batches"][7]["spans"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .filter(|s| !s.is_null())
+                .count(),
+            12
+        );
+    }
+
+    struct ShortFile {
+        file: std::fs::File,
+        remaining: usize,
+        chunk: usize,
+    }
+    impl Write for ShortFile {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if self.remaining == 0 {
+                return Err(std::io::Error::other("injected disk failure"));
+            }
+            let n = bytes.len().min(self.chunk).min(self.remaining);
+            let written = self.file.write(&bytes[..n])?;
+            self.remaining -= written;
+            Ok(written)
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            self.file.flush()
+        }
+    }
+
+    #[test]
+    fn capped_shortwrite_noreplace_and_failed_drain_keep_artifacts() {
+        let mut d = fixture(8, 0, Lifetime::default());
+        let file = path("short-success");
+        export_with(&mut d, &file, 0, None, None, |file| ShortFile {
+            file,
+            remaining: JSON_LIMIT,
+            chunk: 3,
+        })
+        .unwrap();
+        let original = std::fs::read(&file).unwrap();
+        assert!(
+            serde_json::from_slice::<serde_json::Value>(&original).unwrap()["valid"]
+                .as_bool()
+                .unwrap()
+        );
+        assert!(export_data(&mut d, &file, 0, None, None).is_err());
+        assert_eq!(std::fs::read(&file).unwrap(), original);
+        let partial = path("short-failure");
+        assert!(
+            export_with(&mut d, &partial, 0, None, None, |file| ShortFile {
+                file,
+                remaining: 127,
+                chunk: 3
+            })
+            .is_err()
+        );
+        assert_eq!(std::fs::metadata(partial).unwrap().len(), 127);
+        d.errors.push("x".repeat(JSON_LIMIT + 1));
+        let capped = path("capped");
+        assert!(export_data(&mut d, &capped, 0, None, None).is_err());
+        let len = std::fs::metadata(capped).unwrap().len();
+        assert!(len > 0 && len <= JSON_LIMIT as u64);
+        let mut failed = fixture(8, 0, Lifetime::default());
+        failed.drain.status = "failed";
+        failed.checked_counters = None;
+        failed.errors.push("checked drain failed; no retry".into());
+        let j = exported(failed, "failed-drain", false);
+        assert_eq!(j["drain"]["status"], "failed");
+        assert!(j["checked_counters"].is_null());
+        let mut overflow = fixture(64, 0, Lifetime::default());
+        overflow.overflow = true;
+        assert_eq!(
+            exported(overflow, "overflow", false)["batches"]
+                .as_array()
+                .unwrap()
+                .len(),
+            64
+        );
+    }
+}
