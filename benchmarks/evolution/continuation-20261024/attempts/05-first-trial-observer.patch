+    fn fixture_batch(index: usize, enabled: bool, current: Lifetime) -> Batch {
+        let id = index as u64 + 1;
+        let conflict = id % 4 == 0;
+        let split = enabled && conflict;
+        let next = advance(current, 1, u64::from(split)).unwrap();
+        let start = 10 + index as u64 * 4000;
