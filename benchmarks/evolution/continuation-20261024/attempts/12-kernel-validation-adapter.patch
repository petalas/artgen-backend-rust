+def phase_identities(spec, phase):
+    """Resolve one frozen phase's manifest and arm identities at the boundary.
+
+    The legacy shader-only shape supports read-only 106 regression fixtures.
+    Explicit source identities require the kernel experiment's false modes.
+    """
+    identity = spec["identities"]
+    fields = ("reference_shader", "reference_sha256", "candidate_shader", "candidate_sha256")
+    explicit = any(field in identity for field in fields)
+    if explicit:
+        require(all(field in identity for field in (*fields, "manifest_sha256")),
+                "incomplete explicit phase identities")
+        require(phase[4] is False, "kernel experiment requires both overlap modes false")
+        sources = {"reference": (identity["reference_shader"], identity["reference_sha256"]),
+                   phase[5]: (identity["candidate_shader"], identity["candidate_sha256"])}
+    else:
+        require("shader" in identity, "missing shader identities")
+        sources = {"reference": (identity["shader"], AE1), phase[5]: (identity["shader"], AE1)}
+    require(phase[5] != "reference", "candidate arm collides with reference")
+    manifest = identity.get("manifest")
+    manifest_hash = identity.get("manifest_sha256", MANIFEST)
+    for path, digest in [(manifest, manifest_hash), *sources.values()]:
+        require(isinstance(path, str) and Path(path).is_absolute(), "identity path must be absolute")
+        require(isinstance(digest, str) and len(digest) == 64
+                and all(char in "0123456789abcdef" for char in digest), "invalid identity SHA256")
+    return manifest, manifest_hash, sources
+
