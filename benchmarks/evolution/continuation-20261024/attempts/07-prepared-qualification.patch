+    fn qualification_producer_preserves_every_typed_field_and_exact_manifest_params() -> Result<()>
+    {
+        let record = wire_record()?;
+        let expected: serde_json::Value = serde_json::from_slice(&serde_json::to_vec(&record)?)?;
+        let params: serde_json::Value = serde_json::from_str(
+            r#"{
+            "addPolygonProb":0.5,"removePolygonProb":0.000862,"reorderPolygonProb":0.002,
+            "offsetPolygonProb":0.00565,"movePointProb":0.000294,"removePointProb":0.002,
+            "microAdjustProb":0.002786,"changeColorProb":0.000473,"adjustBrightnessProb":0.000473,
+            "adjustSaturationProb":0.001333,"scalePolygonProb":0.00565,"rotatePolygonProb":0.002,
+            "adjacentSwapProb":0.002,"mergePolygonProb":0.000667,"clonePolygonProb":0.071429,
+            "mediumMoveProb":0.004,"swapColorsProb":0.00565,"movePointMaxDelta":0.113,
+            "microAdjustDelta":0.001,"newPointMaxDistance":0.005,"offsetPolygonMagnitude":0.01,
+            "mediumMoveDelta":0.03,"mergeCentroidThreshold":0.15,"mergeColorThreshold":0.2,
+            "minAlpha":10,"maxAlpha":65,"minPolygons":1,"maxPolygons":1000,"crossoverProb":0.2,
+            "spatialCrossoverWeight":0.66,"tournamentSize":3,"chainCount":4,"lambda":64,
+            "singleMutationMode":true,"adaptiveMutation":false,"rasterizeWg":[32,16],"gpuBatchIters":64
+        }"#,
+        )?;
+        for enabled in [false, true] {
+            let value = qualification_value(&record, enabled)?;
+            let mut wire: serde_json::Value = serde_json::from_slice(&serde_json::to_vec(&value)?)?;
+            assert_eq!(wire["schema"], "engine-lab-prepared-v2");
+            assert_eq!(wire["warmup_batches"], 8);
+            assert_eq!(wire["finalize_overlap"], enabled);
+            assert_eq!(wire["params"], params);
+            assert_eq!(wire["initial_similarity_percent"], 98.2);
+            assert_eq!(wire["initial_quality"][0]["stored_fitness"], 97.3);
+            assert_eq!(wire["elapsed_seconds"], 1.234_567_890_123_456_7);
+            for key in [
