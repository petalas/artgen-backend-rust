+        require(sha(binary) == spec["identities"]["binary_sha256"], "binary changed between phases")
+        require(sha(manifest) == MANIFEST and sha(shader) == AE1, "inputs changed between phases")
+        process = admitted_call(deadline, time.monotonic(), True, lambda timeout, folder=folder, phase=phase: b.run_process(
+            command_for(binary, manifest, shader, folder, phase), folder / "cwd", folder / "evidence", timeout))
+        entry["process"] = process
+        entry["work"] = partial_work(b, folder / "output")
+        checkpoint(b, state)
+        require(process.get("status") == "completed" and process.get("returncode") == 0, "child stopped/failed")
+        require(time.monotonic() < deadline, "deadline exceeded after child")
+        entry.update(validate_phase(compare, b, folder, phase, spec, fixtures, gpu_identities))
+        require(time.monotonic() < deadline, "deadline exceeded during validation")
+        if name in ("aa", "train"):
+            entry["gate"] = gate(compare, entry["ratios"], aa=name == "aa")
+            outcome = "pass" if entry["gate"]["pass"] else "fail"
+        else:
+            reserved.update(entry["ratios"])
+            outcome = "pass"  # Validity only. No reserved per-case timing decision.
+        state["state"] = transition(state["state"], name, outcome)
+        checkpoint(b, state)
+        print(f"phase {name} {state['state']}", flush=True)
+        if state["state"] in ("INCONCLUSIVE", "REJECT"):
+            return
+    state["reserved_gate"] = gate(compare, reserved)
+    state["state"] = transition(state["state"], "reserved-gate",
+                                "pass" if state["reserved_gate"]["pass"] else "fail")
+
+
+def main(argv=None):
+    require(not (sys.argv[1:] if argv is None else argv), "this frozen command accepts no arguments")
+    started = time.monotonic()  # Fresh clock precedes lock and every preflight operation.
+    deadline = started + 1800
+    compare, b = load_helpers()
+    require(sha(TARGET / "spec.json") == SPEC_SHA, "frozen spec changed")
+    state = {"state": "NEW", "checkpoint": 0, "phases": [], "errors": [],
+             "started_utc": b.utc_now(), "monotonic_start": started, "monotonic_deadline": deadline,
+             "spec_sha256": SPEC_SHA, "helper_sha256": HELPERS,
+             "scope": "conditional prepared throughput; old warmup2 REJECT unchanged; no adoption/default flip",
+             "limitations": "AA eight batches only; conditional timing intervals, one reserved seed per case; "
+                            "isolation/causal limiter/whole-app startup unresolved; independent byte-L1 audit follows"}
+    b.write_json(TARGET / "clock.json", state)  # Exclusive one-shot marker. Never resume/retry this namespace.
+    failures = (Invalid, b.BenchError, OSError, ValueError, KeyError, TypeError, OverflowError,
+                AttributeError, IndexError, ZeroDivisionError, RecursionError, KeyboardInterrupt)
+    try:
+        with compare.cancellation_signals(), b.benchmark_lock(b.DEFAULT_ROOT / "benchmark.lock"):
+            checkpoint(b, state)
+            spec, binary, manifest, shader, fixtures = preflight(b)
+            run_phases(compare, b, state, deadline, spec, binary, manifest, shader, fixtures)
+            require(time.monotonic() < deadline, "deadline exceeded during analysis")
+            if state["state"] == "PASS_PREPARED_CONDITIONAL":
+                logical = sum(p["work"]["logical_evaluations_lower_bound"] for p in state["phases"])
+                require(logical == spec["expected_full_evaluations"]["logical_total"], "logical total mismatch")
+    except failures as exc:
+        state["state"] = "INCONCLUSIVE"
+        state["errors"].append(f"{type(exc).__name__}: {exc}")
+        if state["phases"]:
+            last = state["phases"][-1]
+            try:
+                last["partial_work_after_stop"] = partial_work(b, Path(last["directory"]) / "output")
+            except (Invalid, b.BenchError, OSError, ValueError, TypeError) as partial_error:
+                state["errors"].append(f"partial accounting failed: {partial_error}")
+    state["controller_wall_seconds"] = time.monotonic() - started
+    if time.monotonic() >= deadline:
