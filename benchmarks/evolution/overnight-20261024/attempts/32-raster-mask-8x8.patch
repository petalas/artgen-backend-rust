+// Conservative pixel bbox from packed u16 extrema; no new floating-point work.
+fn polygon_subtile_mask(poly: Polygon, tile_origin: vec2<u32>, image_size: vec2<u32>) -> u32 {
+    // Preserve the full image contract when the small-integer proof does not apply.
+    if any(image_size == vec2<u32>(0u)) || any(image_size > vec2<u32>(512u)) {
+        return 0xFFFFFFFFu;
+    }
+    let q0 = vec2<u32>(poly.data.y & 0xFFFFu, poly.data.y >> 16u);
+    let q1 = vec2<u32>(poly.data.z & 0xFFFFu, poly.data.z >> 16u);
+    let q2 = vec2<u32>(poly.data.w & 0xFFFFu, poly.data.w >> 16u);
+    let q_min = min(q0, min(q1, q2));
+    let q_max = max(q0, max(q1, q2));
+    let floor_min = (q_min * image_size) / vec2<u32>(65535u);
+    let pixel_min = floor_min - min(floor_min, vec2<u32>(1u));
+    let ceil_max = (q_max * image_size + vec2<u32>(65534u)) / vec2<u32>(65535u);
+    let pixel_max = min(ceil_max + vec2<u32>(1u), image_size);
+
+    let start = max(pixel_min, tile_origin);
+    let end = min(pixel_max, min(tile_origin + vec2<u32>(WG_X, WG_Y), image_size));
+    if any(end <= start) {
+        return 0u;
+    }
+    // Guard above precedes every unsigned subtraction of a clipped endpoint.
+    let first = (start - tile_origin) / vec2<u32>(8u);
+    let last = (end - vec2<u32>(1u) - tile_origin) / vec2<u32>(8u);
+    let columns = WG_X / 8u;
+    let row_mask = ((1u << (last.x - first.x + 1u)) - 1u) << first.x;
+    var mask = 0u;
+    for (var row = 0u; row < 2u; row++) {
+        if row >= first.y && row <= last.y {
+            mask |= row_mask << (row * columns);
+        }
+    }
+    return mask;
+}
