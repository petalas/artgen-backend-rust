+        sg_sum = packed_sum & 0xFFFFu;
+        sg_sum_old = packed_sum >> 16u;
+    } else {
+        sg_sum = subgroupAdd(pixel_error);
+        sg_sum_old = subgroupAdd(pixel_error_old);
+    }
     if sg_inv_id == 0u {
